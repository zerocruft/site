{
  "name": "zerocruft-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node -e \"const fs=require('fs');const p='dist/index.html';if(fs.existsSync(p)){let h=fs.readFileSync(p,'utf8');h=h.replaceAll('href=\\\"/_astro/','href=\\\"./_astro/').replaceAll('src=\\\"/brand-avatar','src=\\\"./brand-avatar');fs.writeFileSync(p,h);}\"",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.8",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
