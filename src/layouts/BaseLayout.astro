---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import OrganizationSchema from '../components/schema/OrganizationSchema.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title = "ZeroCruft | Anti-Bloat Engineering & Terminal Receipts",
  description = "Official companion hub for @zerocruft. Anti-bloat engineering, testing under constraints, terminal receipts, and squeezing maximum utility out of Linux and raw silicon.",
  image = "/brand-avatar.png",
  canonicalUrl = Astro.url.href,
} = Astro.props;

const siteUrl = "https://site.zerocruft.workers.dev";
const fullImageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta name="google-site-verification" content="iLW-giOSko06Nprh1uDG8zMEkKXA_Hq7LYoBY0veyqM" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0d12" />
    <meta name="color-scheme" content="dark" />

    <!-- SEO Primary -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content="ZeroCruft" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:site_name" content="ZeroCruft" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@zerocruft" />
    <meta name="twitter:creator" content="@zerocruft" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- Apple HIG Favicons & Touch Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="ZeroCruft" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Syndication & Discovery -->
    <link rel="alternate" type="application/rss+xml" title="ZeroCruft RSS Feed" href="/rss.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Answer.AI LLM Manifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- JSON-LD Root Organization Schema -->
    <OrganizationSchema siteUrl={siteUrl} />
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
