---
interface Props {
  targetId?: string;
  text?: string;
  label?: string;
}

const { targetId, text = '', label = 'Copy' } = Astro.props;
---

<button
  type="button"
  class="copy-btn"
  data-copy-target={targetId}
  data-copy-text={text}
  aria-label="Copy to clipboard"
>
  <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
  </svg>
  <svg class="check-icon" style="display:none;" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="20 6 9 17 4 12"></polyline>
  </svg>
  <span class="copy-label">{label}</span>
</button>

<script>
  // Progressive enhancement: Zero external bloat, ~25 lines of vanilla clipboard logic
  function setupCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((button) => {
      if (button.dataset.initialized) return;
      button.dataset.initialized = 'true';

      button.addEventListener('click', async () => {
        let textToCopy = button.dataset.copyText;
        const targetId = button.dataset.copyTarget;

        if (!textToCopy && targetId) {
          const target = document.getElementById(targetId);
          if (target) {
            textToCopy = target.innerText;
          }
        }

        if (!textToCopy) {
          // If neither, copy nearest pre/code block
          const codeBlock = button.closest('.terminal-block')?.querySelector('pre') || button.nextElementSibling;
          if (codeBlock) {
            textToCopy = codeBlock.textContent || '';
          }
        }

        if (!textToCopy) return;

        try {
          await navigator.clipboard.writeText(textToCopy.trim());
          const copyIcon = button.querySelector<SVGElement>('.copy-icon');
          const checkIcon = button.querySelector<SVGElement>('.check-icon');
          const label = button.querySelector<HTMLElement>('.copy-label');

          button.classList.add('copied');
          if (copyIcon) copyIcon.style.display = 'none';
          if (checkIcon) checkIcon.style.display = 'inline';
          if (label) label.textContent = 'Copied!';

          setTimeout(() => {
            button.classList.remove('copied');
            if (copyIcon) copyIcon.style.display = 'inline';
            if (checkIcon) checkIcon.style.display = 'none';
            if (label) label.textContent = button.dataset.copyText ? 'Copy' : (button.getAttribute('aria-label') || 'Copy');
          }, 2000);
        } catch (err) {
          console.error('Clipboard copy failed:', err);
        }
      });
    });
  }

  setupCopyButtons();
  document.addEventListener('astro:page-load', setupCopyButtons);
</script>
