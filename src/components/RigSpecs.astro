---
// Hardware Test Rig Telemetry Matrix
// Authentic Reproducible Benchmarks Specification
// Blueprint: spec-matrix
---

<section class="rig-specs-root">
  <div class="container">
    <div class="spec-matrix-container font-mono">
      <!-- Matrix Header -->
      <div class="spec-matrix-header">
        <div class="header-left">
          <span class="matrix-tag text-accent font-mono">[STANDARDIZED BENCHMARK RIG]</span>
          <span class="matrix-sub font-mono">ZEN 4 ARCHITECTURE</span>
        </div>
        <div class="header-right font-mono">
          <span>RECEIPT TARGET: BARE SILICON</span>
        </div>
      </div>

      <!-- Hairline Divided Grid (Zero Card Soup) -->
      <div class="spec-matrix-grid">
        <!-- CPU Spec -->
        <div class="spec-matrix-cell">
          <div class="cell-label font-mono">
            <span class="key-id text-accent">[CPU]</span>
            <span class="bus-meta">16C / 32T</span>
          </div>
          <div class="cell-value font-mono">AMD Zen 4 Ryzen 9</div>
          <div class="cell-detail font-mono">5.7 GHz Boost • 64MB L3 Cache</div>
        </div>

        <!-- RAM Spec -->
        <div class="spec-matrix-cell">
          <div class="cell-label font-mono">
            <span class="key-id text-accent">[MEM]</span>
            <span class="bus-meta">SUB-60NS</span>
          </div>
          <div class="cell-value font-mono">64GB DDR5-6000 ECC</div>
          <div class="cell-detail font-mono">1:1 FCLK • CL30 Ultra-Low Latency</div>
        </div>

        <!-- Storage Spec -->
        <div class="spec-matrix-cell">
          <div class="cell-label font-mono">
            <span class="key-id text-accent">[NVME]</span>
            <span class="bus-meta">IO_URING</span>
          </div>
          <div class="cell-value font-mono">PCIe Gen4 x4 NVMe</div>
          <div class="cell-detail font-mono">Direct-I/O Bypass • 7,450 MB/s</div>
        </div>

        <!-- OS & Kernel Spec -->
        <div class="spec-matrix-cell">
          <div class="cell-label font-mono">
            <span class="key-id text-accent">[KERNEL]</span>
            <span class="bus-meta text-accent">0 kB CLIENT JS</span>
          </div>
          <div class="cell-value font-mono">Arch Linux Kernel Zen</div>
          <div class="cell-detail font-mono">PREEMPT_RT • EEVDF Tuning</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .rig-specs-root {
    width: 100%;
    padding-top: var(--space-6);
    padding-bottom: var(--space-10);
  }

  .spec-matrix-container {
    width: 100%;
    background: #08090c;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .spec-matrix-header {
    height: 48px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--space-5);
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.75rem;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .matrix-tag {
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .matrix-sub {
    color: var(--color-text-tertiary);
    font-size: 0.6875rem;
  }

  .header-right {
    font-size: 0.6875rem;
    color: var(--color-text-tertiary);
    letter-spacing: 0.05em;
  }

  /* 4-Column Hairline Grid */
  .spec-matrix-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .spec-matrix-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .spec-matrix-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .spec-matrix-cell {
    min-height: 120px;
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-sizing: border-box;
    transition: var(--spring-micro);
  }

  @media (min-width: 640px) {
    .spec-matrix-cell:nth-child(odd) {
      border-right: 1px solid rgba(255, 255, 255, 0.08);
    }
    .spec-matrix-cell:nth-last-child(-n+2) {
      border-bottom: none;
    }
  }

  @media (min-width: 1024px) {
    .spec-matrix-cell {
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      border-bottom: none;
    }
    .spec-matrix-cell:last-child {
      border-right: none;
    }
  }

  .spec-matrix-cell:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .cell-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.6875rem;
  }

  .key-id {
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .bus-meta {
    color: var(--color-text-tertiary);
    font-size: 0.625rem;
  }

  .cell-value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .cell-detail {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .text-accent {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .spec-matrix-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
    }
    .spec-matrix-cell:last-child {
      border-bottom: none;
    }
  }
</style>