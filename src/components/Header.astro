---
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-floating-island">
    <div class="container header-container">
      <a href="/" class="brand-link" aria-label="ZeroCruft Home">
        <img
          src="/brand-avatar.png"
          alt="ZeroCruft Brand Avatar"
          width="32"
          height="32"
          class="brand-avatar"
        />
        <div class="brand-text">
          <span class="brand-name">ZeroCruft</span>
          <span class="brand-handle">@zerocruft</span>
        </div>
      </a>

      <!-- Platform Technical Standard -->
      <div class="header-rig-beacon" title="Linux Benchmark Environment Active">
        <span class="beacon-text font-mono">ARCH LINUX // 0 kB JS</span>
      </div>

      <nav class="nav-links" aria-label="Main Navigation">
        <a href="/#manifesto" class="nav-link">Manifesto</a>
        <a href="/#guides" class="nav-link">Guides</a>
        <a href="/llms.txt" class="nav-link font-mono text-footnote" title="Answer.AI LLM Manifest">llms.txt</a>
        <a
          href="https://www.youtube.com/@zerocruft"
          target="_blank"
          rel="noopener noreferrer"
          class="nav-link nav-youtube"
          aria-label="ZeroCruft on YouTube"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          <span class="hide-mobile">YouTube</span>
        </a>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    height: 72px;
    box-sizing: border-box;
    padding: var(--space-2) var(--space-4);
  }

  .header-floating-island {
    max-width: 1200px;
    margin: 0 auto;
    height: 56px;
    box-sizing: border-box;
    background: rgba(14, 18, 26, 0.90);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-full);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    padding: 0 var(--space-4);
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-sm);
    transition: var(--spring-micro);
  }

  .brand-link:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .brand-avatar {
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.16);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    line-height: 1.1;
  }

  .brand-handle {
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
  }

  /* Technical Architecture Tag */
  .header-rig-beacon {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 var(--space-3);
    background: rgba(48, 209, 88, 0.08);
    border: 1px solid rgba(48, 209, 88, 0.24);
    border-radius: var(--radius-sm);
  }

  .beacon-text {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 44px;
    min-height: 44px;
    padding: 0 var(--space-3);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    border-radius: var(--radius-sm);
    transition: var(--spring-micro);
  }

  .nav-link:hover {
    color: var(--color-text-primary);
    background: rgba(255, 255, 255, 0.08);
  }

  .nav-youtube {
    color: #ffffff;
    background: var(--color-youtube);
  }

  .nav-youtube:hover {
    background: #ff4747;
    color: #ffffff;
  }

  @media (max-width: 640px) {
    .header-rig-beacon {
      display: none;
    }
    .hide-mobile {
      display: none;
    }
  }
</style>
