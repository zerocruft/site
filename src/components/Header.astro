---
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-container">
    <a href="/" class="brand-link" aria-label="ZeroCruft Home">
      <img
        src="/brand-avatar.png"
        alt="ZeroCruft Brand Avatar"
        width="34"
        height="34"
        class="brand-avatar"
      />
      <div class="brand-text">
        <span class="brand-name">ZeroCruft</span>
        <span class="brand-handle">@zerocruft</span>
      </div>
    </a>

    <nav class="nav-links" aria-label="Main Navigation">
      <a href="/#manifesto" class="nav-link">Manifesto</a>
      <a href="/#launch" class="nav-link">Status</a>
      <a href="/#receipts" class="nav-link">Receipts</a>
      <a href="/llms.txt" class="nav-link font-mono text-footnote" title="Answer.AI LLM Manifest">llms.txt</a>
      <a
        href="https://www.youtube.com/@zerocruft"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-link nav-youtube"
        aria-label="ZeroCruft on YouTube"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        <span class="hide-mobile">YouTube</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background: rgba(10, 13, 18, 0.82);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: var(--border-subtle);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-md);
    transition: var(--spring-micro);
  }

  .brand-link:hover {
    background: rgba(255, 255, 255, 0.04);
  }

  .brand-avatar {
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 0 12px rgba(48, 209, 88, 0.15);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .brand-handle {
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
    line-height: 1;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    min-width: 44px;
    padding: 0 var(--space-3);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    border-radius: var(--radius-sm);
    transition: var(--spring-micro);
  }

  .nav-link:hover {
    color: var(--color-text-primary);
    background: rgba(255, 255, 255, 0.06);
  }

  .nav-youtube {
    color: var(--color-youtube);
    background: var(--color-youtube-subtle);
  }

  .nav-youtube:hover {
    background: rgba(255, 51, 51, 0.22);
    color: #ff5252;
  }

  @media (max-width: 540px) {
    .hide-mobile {
      display: none;
    }
  }
</style>
