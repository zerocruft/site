---
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-floating-island">
    <div class="container header-container">
      <a href="/" class="brand-link" aria-label="ZeroCruft Home">
        <img
          src="/brand-avatar.png"
          alt="ZeroCruft Brand Avatar"
          width="32"
          height="32"
          class="brand-avatar"
        />
        <div class="brand-text">
          <span class="brand-name">ZeroCruft</span>
          <span class="brand-handle">@zerocruft</span>
        </div>
      </a>

      <!-- Benchmark Rig Online Beacon -->
      <div class="header-rig-beacon" title="Hardware Benchmark Cluster Active">
        <span class="beacon-dot" aria-hidden="true"></span>
        <span class="beacon-text font-mono">RIG ONLINE // 0 kB JS</span>
      </div>

      <nav class="nav-links" aria-label="Main Navigation">
        <a href="/#manifesto" class="nav-link">Manifesto</a>
        <a href="/#guides" class="nav-link">Guides</a>
        <a href="/llms.txt" class="nav-link font-mono text-footnote" title="Answer.AI LLM Manifest">llms.txt</a>
        <a
          href="https://www.youtube.com/@zerocruft"
          target="_blank"
          rel="noopener noreferrer"
          class="nav-link nav-youtube"
          aria-label="ZeroCruft on YouTube"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          <span class="hide-mobile">YouTube</span>
        </a>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    padding: var(--space-2) var(--space-4);
  }

  .header-floating-island {
    max-width: 1200px;
    margin: 0 auto;
    background: rgba(14, 18, 26, 0.75);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-full);
    box-shadow: 
      0 12px 32px -8px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.10);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 54px;
    padding: 0 var(--space-3);
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-full);
    transition: var(--spring-micro);
  }

  .brand-link:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .brand-avatar {
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 0 10px rgba(48, 209, 88, 0.15);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    line-height: 1.1;
  }

  .brand-handle {
    font-size: 0.625rem;
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
  }

  /* Status Beacon */
  .header-rig-beacon {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    background: rgba(48, 209, 88, 0.08);
    border: 1px solid rgba(48, 209, 88, 0.22);
    border-radius: var(--radius-full);
  }

  .beacon-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 8px var(--color-accent);
  }

  .beacon-text {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 38px;
    padding: 0 var(--space-3);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    border-radius: var(--radius-full);
    transition: var(--spring-micro);
  }

  .nav-link:hover {
    color: var(--color-text-primary);
    background: rgba(255, 255, 255, 0.08);
  }

  .nav-youtube {
    color: #ffffff;
    background: var(--color-youtube);
    box-shadow: 0 2px 10px rgba(255, 51, 51, 0.3);
  }

  .nav-youtube:hover {
    background: #ff4747;
    box-shadow: 0 4px 14px rgba(255, 51, 51, 0.45);
    color: #ffffff;
  }

  @media (max-width: 640px) {
    .header-rig-beacon {
      display: none;
    }
    .hide-mobile {
      display: none;
    }
  }
</style>
