---
// Zero Cruft Authentic Terminal Receipt Component
// 0 kB Client JavaScript - Powered by semantic radio inputs and CSS :checked states
// Blueprint: hero-systems & terminal-raw
---

<div class="terminal-receipt-root">
  <div class="receipt-container">
    <!-- Top Telemetry Command Header (Zero Toy Window Chrome) -->
    <div class="receipt-header font-mono">
      <div class="header-left">
        <span class="prompt-glyph text-accent font-mono">$</span>
        <span class="prompt-env font-mono">zen4-rt:benchmarks/receipts</span>
      </div>
      <div class="header-right font-mono">
        <span class="receipt-status-pill font-mono">REPRODUCIBLE RUN</span>
      </div>
    </div>

    <!-- Hidden Radio Controls for Pure CSS Command Switching -->
    <input
      type="radio"
      name="receipt-cmd"
      id="cmd-nvme"
      class="receipt-radio sr-only"
      checked
    />
    <input
      type="radio"
      name="receipt-cmd"
      id="cmd-perf"
      class="receipt-radio sr-only"
    />
    <input
      type="radio"
      name="receipt-cmd"
      id="cmd-footprint"
      class="receipt-radio sr-only"
    />

    <!-- Interactive Command Selector (Min 44x44pt Tap Targets) -->
    <div class="receipt-command-bar font-mono" role="tablist" aria-label="Terminal Receipt Selector">
      <label for="cmd-nvme" class="cmd-chip chip-nvme" role="tab" tabindex="0">
        <span class="cmd-arg font-mono">01</span>
        <span class="cmd-label font-mono">fio --direct=1</span>
        <span class="cmd-tag font-mono">241k IOPS</span>
      </label>

      <label for="cmd-perf" class="cmd-chip chip-perf" role="tab" tabindex="0">
        <span class="cmd-arg font-mono">02</span>
        <span class="cmd-label font-mono">perf stat -B</span>
        <span class="cmd-tag font-mono">2.60 IPC</span>
      </label>

      <label for="cmd-footprint" class="cmd-chip chip-footprint" role="tab" tabindex="0">
        <span class="cmd-arg font-mono">03</span>
        <span class="cmd-label font-mono">ps_mem --total</span>
        <span class="cmd-tag font-mono">1.1 MiB</span>
      </label>
    </div>

    <!-- Receipt Output Body (Raw <pre><code> Character Grid) -->
    <div class="receipt-output-viewport">
      <!-- Panel 1: NVMe Direct-I/O -->
      <div class="output-panel panel-nvme" role="tabpanel">
        <div class="output-cmd-line font-mono">
          <span class="prompt-sym font-mono">$</span>
          <span class="prompt-text font-mono">sudo fio --filename=/dev/nvme0n1 --direct=1 --rw=randread --bs=4k --ioengine=io_uring --iodepth=32</span>
        </div>

        <pre class="code-stream font-mono"><code><span class="c-dim">fio-3.37; Jobs: 1 (f=1): [r(1)][100.0%][r=942MiB/s, 241k IOPS]</span>
<span class="c-accent">read:</span> IOPS=<span class="c-bright">241k</span>, BW=<span class="c-bright">942MiB/s</span> (988MB/s) (9420MiB/10001msec)
  <span class="c-cyan">slat (nsec):</span> min=850, max=14,201, avg=1120.4
  <span class="c-cyan">clat (usec):</span> min=48,  max=329,    avg=128.2, stdev=14.1
   <span class="c-bright">lat (usec):</span> min=51,  max=334,    avg=<span class="c-accent">129.5</span>
  <span class="c-cyan">clat percentiles (usec):</span>
   |  90.00th=[<span class="c-bright">141</span>], 99.00th=[<span class="c-amber">169</span>], 99.90th=[<span class="c-amber">225</span>], 99.99th=[<span class="c-red">297</span>]
  <span class="c-cyan">cpu          :</span> usr=4.12%, sys=12.44%, ctx=241,419, majf=0, minf=14</code></pre>

        <div class="output-telemetry-row font-mono">
          <div class="telemetry-cell">
            <span class="label font-mono">IOPS</span>
            <span class="val font-mono text-accent">241,000 / sec</span>
          </div>
          <div class="telemetry-divider"></div>
          <div class="telemetry-cell">
            <span class="label font-mono">P50 LATENCY</span>
            <span class="val font-mono text-accent">129.5 μs</span>
          </div>
          <div class="telemetry-divider"></div>
          <div class="telemetry-cell">
            <span class="label font-mono">PAGE CACHE</span>
            <span class="val font-mono">0.00 kB (BYPASS)</span>
          </div>
        </div>
      </div>

      <!-- Panel 2: Kernel Perf -->
      <div class="output-panel panel-perf" role="tabpanel">
        <div class="output-cmd-line font-mono">
          <span class="prompt-sym font-mono">$</span>
          <span class="prompt-text font-mono">perf stat -B -e cycles,instructions,cache-references,cache-misses -- ./zerocruft-bench</span>
        </div>

        <pre class="code-stream font-mono"><code><span class="c-dim">Performance counter stats for './zerocruft-bench' (10 runs):</span>

  <span class="c-bright">4,128,491,204</span>      cycles                    <span class="c-cyan">#    4.821 GHz</span>
 <span class="c-accent">10,734,077,130</span>      instructions              <span class="c-accent">#    2.60  insn per cycle</span>
     <span class="c-bright">28,144,902</span>      cache-references          <span class="c-cyan">#   32.868 M/sec</span>
      <span class="c-accent">1,407,245</span>      cache-misses              <span class="c-accent">#    5.00% of all L1D hits</span>
      <span class="c-bright">4,219,812</span>      L1-dcache-load-misses     <span class="c-cyan">#    0.82% of L1-dcache</span>

  <span class="c-bright">0.856350711</span> seconds time elapsed (<span class="c-accent">± 0.12%</span>)
  <span class="c-bright">0.854120000</span> seconds user | <span class="c-accent">0.002230000</span> seconds sys</code></pre>

        <div class="output-telemetry-row font-mono">
          <div class="telemetry-cell">
            <span class="label font-mono">IPC EFFICIENCY</span>
            <span class="val font-mono text-accent">2.60 INS/CYCLE</span>
          </div>
          <div class="telemetry-divider"></div>
          <div class="telemetry-cell">
            <span class="label font-mono">L3 AFFINITY</span>
            <span class="val font-mono text-accent">95.0% HIT RATE</span>
          </div>
          <div class="telemetry-divider"></div>
          <div class="telemetry-cell">
            <span class="label font-mono">KERNEL OVERHEAD</span>
            <span class="val font-mono">0.26% SYS TIME</span>
          </div>
        </div>
      </div>

      <!-- Panel 3: Silicon Footprint -->
      <div class="output-panel panel-footprint" role="tabpanel">
        <div class="output-cmd-line font-mono">
          <span class="prompt-sym font-mono">$</span>
          <span class="prompt-text font-mono">ps_mem --total | grep -E "zerocruft-daemon|slack|teams-for-linux"</span>
        </div>

        <pre class="code-stream font-mono"><code><span class="c-dim"> Private   +   Shared   =  RAM Used	Program</span>
 ---------------------------------------------------------
 <span class="c-accent">748.0 KiB +  412.0 KiB =    1.1 MiB</span>	<span class="c-accent">zerocruft-daemon (Rust / Zen4)</span>
 412.8 MiB +   88.4 MiB =  501.2 MiB	teams-for-linux (Chromium)
 684.2 MiB +  112.5 MiB =  796.7 MiB	slack (Electron v31)
 ---------------------------------------------------------
 <span class="c-bright">TOTAL RUNTIME MEMORY DELTA:</span>
 <span class="c-accent">1.1 MiB</span> vs <span class="c-red">1,297.9 MiB</span> (<span class="c-accent">99.91% Silicon Waste Eradicated</span>)</code></pre>

        <div class="output-telemetry-row font-mono">
          <div class="telemetry-cell">
            <span class="label font-mono">NATIVE DAEMON</span>
            <span class="val font-mono text-accent">1.1 MiB RAM</span>
          </div>
          <div class="telemetry-divider"></div>
          <div class="telemetry-cell">
            <span class="label font-mono">WEB RUNTIME</span>
            <span class="val font-mono text-red">1,297.9 MiB</span>
          </div>
          <div class="telemetry-divider"></div>
          <div class="telemetry-cell">
            <span class="label font-mono">MEMORY RATIO</span>
            <span class="val font-mono text-accent">1,179x LEANER</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Discreet Verification Satellite Footer -->
    <div class="receipt-satellite-bar font-mono">
      <div class="satellite-left">
        <span class="satellite-check">✓</span>
        <span class="satellite-hash">RECEIPT SHA256: 8f9b2c...e41a</span>
      </div>
      <div class="satellite-right">
        <span>ARCH LINUX // 0 kB CLIENT JS</span>
      </div>
    </div>
  </div>
</div>

<style>
  .terminal-receipt-root {
    width: 100%;
    position: relative;
  }

  .receipt-container {
    width: 100%;
    background: #06080d;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  /* Header (Zero Toy Window Chrome) */
  .receipt-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 40px;
    padding: 0 var(--space-4);
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.75rem;
    box-sizing: border-box;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .prompt-glyph {
    color: var(--color-accent);
    font-weight: 700;
  }

  .prompt-env {
    color: var(--color-text-secondary);
  }

  .receipt-status-pill {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.05em;
  }

  /* Command Selector with 44px min-height tap targets */
  .receipt-command-bar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .cmd-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-3);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    cursor: pointer;
    transition: var(--spring-micro);
    user-select: none;
    box-sizing: border-box;
  }

  .cmd-chip:last-child {
    border-right: none;
  }

  .cmd-chip:hover {
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-text-primary);
  }

  .cmd-arg {
    color: var(--color-text-tertiary);
    font-size: 0.6875rem;
  }

  .cmd-tag {
    font-size: 0.6875rem;
    padding: 4px 8px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-text-tertiary);
  }

  /* Pure CSS Toggle Mechanics */
  .sr-only {
    position: absolute;
    width: 0;
    height: 0;
    padding: 0;
    margin: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .receipt-container:has(#cmd-nvme:checked) .chip-nvme,
  .receipt-container:has(#cmd-perf:checked) .chip-perf,
  .receipt-container:has(#cmd-footprint:checked) .chip-footprint {
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
    box-shadow: inset 0 -2px 0 var(--color-accent);
  }

  .receipt-container:has(#cmd-nvme:checked) .chip-nvme .cmd-tag,
  .receipt-container:has(#cmd-perf:checked) .chip-perf .cmd-tag,
  .receipt-container:has(#cmd-footprint:checked) .chip-footprint .cmd-tag {
    background: rgba(48, 209, 88, 0.12);
    color: var(--color-accent);
  }

  .output-panel {
    display: none;
    padding: var(--space-4);
  }

  .receipt-container:has(#cmd-nvme:checked) .panel-nvme {
    display: block;
  }

  .receipt-container:has(#cmd-perf:checked) .panel-perf {
    display: block;
  }

  .receipt-container:has(#cmd-footprint:checked) .panel-footprint {
    display: block;
  }

  .output-cmd-line {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    overflow-x: auto;
  }

  .prompt-sym {
    color: var(--color-accent);
    font-weight: 700;
  }

  .code-stream {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #e6edf3;
    overflow-x: auto;
    margin-bottom: var(--space-4);
  }

  /* Color accents */
  .c-accent { color: var(--color-accent); }
  .c-bright { color: #ffffff; font-weight: 600; }
  .c-cyan   { color: #38bdf8; }
  .c-amber  { color: #fbbf24; }
  .c-red    { color: #f87171; }
  .c-dim    { color: rgba(255, 255, 255, 0.40); }

  /* Output Telemetry Row */
  .output-telemetry-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    padding: var(--space-3);
    background: rgba(0, 0, 0, 0.40);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: var(--radius-sm);
  }

  .telemetry-cell {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .telemetry-cell .label {
    font-size: 0.625rem;
    color: var(--color-text-tertiary);
    letter-spacing: 0.05em;
  }

  .telemetry-cell .val {
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .telemetry-divider {
    display: none;
  }

  .text-accent {
    color: var(--color-accent);
  }

  .text-red {
    color: #f87171;
  }

  /* Discreet Verification Satellite Footer */
  .receipt-satellite-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 36px;
    padding: 0 var(--space-4);
    background: rgba(0, 0, 0, 0.30);
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    font-size: 0.6875rem;
    color: var(--color-text-tertiary);
    box-sizing: border-box;
  }

  .satellite-left {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .satellite-check {
    color: var(--color-accent);
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .receipt-command-bar {
      grid-template-columns: 1fr;
    }
    .cmd-chip {
      border-right: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .output-telemetry-row {
      grid-template-columns: 1fr;
    }
  }
</style>