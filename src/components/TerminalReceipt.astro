---
// Zero Cruft Pure CSS Interactive Terminal Receipt Component
// 0 kB Client JavaScript - Powered by semantic radio inputs and CSS :checked states
---

<div class="terminal-receipt-root">
  <div class="terminal-card card-glass-elevated">
    <!-- Terminal Header Frame -->
    <div class="terminal-chrome">
      <div class="terminal-title">
        <span class="terminal-prompt-sym font-mono">$</span>
        <span class="terminal-user font-mono">receipts@zerocruft</span>
        <span class="terminal-host font-mono">:~ [zen4-rt]</span>
      </div>

      <div class="terminal-status-tag font-mono">
        <span>REPRODUCIBLE RUN</span>
      </div>
    </div>

    <!-- Hidden Radio Controls for Pure CSS Tab Switching -->
    <input
      type="radio"
      name="receipt-tab"
      id="tab-nvme"
      class="receipt-radio sr-only"
      checked
    />
    <input
      type="radio"
      name="receipt-tab"
      id="tab-perf"
      class="receipt-radio sr-only"
    />
    <input
      type="radio"
      name="receipt-tab"
      id="tab-footprint"
      class="receipt-radio sr-only"
    />

    <!-- Interactive Tab Navigation (Labels linked to radios) -->
    <div class="receipt-tabs" role="tablist" aria-label="Terminal Receipt Tabs">
      <label for="tab-nvme" class="receipt-tab-label tab-label-nvme" role="tab" tabindex="0">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tab-icon">
          <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
          <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
          <line x1="6" y1="6" x2="6.01" y2="6"></line>
          <line x1="6" y1="18" x2="6.01" y2="18"></line>
        </svg>
        <span>NVMe I/O</span>
        <span class="tab-badge">fio</span>
      </label>

      <label for="tab-perf" class="receipt-tab-label tab-label-perf" role="tab" tabindex="0">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tab-icon">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
        </svg>
        <span>Kernel Perf</span>
        <span class="tab-badge">perf</span>
      </label>

      <label for="tab-footprint" class="receipt-tab-label tab-label-footprint" role="tab" tabindex="0">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tab-icon">
          <path d="M18 20V10"></path>
          <path d="M12 20V4"></path>
          <path d="M6 20v-6"></path>
        </svg>
        <span>Silicon Footprint</span>
        <span class="tab-badge">ps_mem</span>
      </label>
    </div>

    <!-- Receipt Output Body -->
    <div class="receipt-panels">
      <!-- Panel 1: NVMe Direct-I/O -->
      <div class="receipt-panel panel-nvme" role="tabpanel">
        <div class="receipt-cmd-row">
          <span class="prompt-symbol font-mono">$</span>
          <span class="prompt-cmd font-mono">sudo fio --filename=/dev/nvme0n1 --direct=1 --rw=randread --bs=4k --ioengine=io_uring --iodepth=32 --group_reporting</span>
        </div>

        <pre class="receipt-code-block font-mono"><code><span class="c-dim">fio-3.37; Jobs: 1 (f=1): [r(1)][100.0%][r=942MiB/s, 241k IOPS]</span>
<span class="c-accent">read:</span> IOPS=<span class="c-bright">241k</span>, BW=<span class="c-bright">942MiB/s</span> (988MB/s) (9420MiB/10001msec)
  <span class="c-cyan">slat (nsec):</span> min=850, max=14,201, avg=1120.4
  <span class="c-cyan">clat (usec):</span> min=48,  max=329,    avg=128.2, stdev=14.1
   <span class="c-bright">lat (usec):</span> min=51,  max=334,    avg=<span class="c-accent">129.5</span>
  <span class="c-cyan">clat percentiles (usec):</span>
   |  90.00th=[<span class="c-bright">141</span>], 99.00th=[<span class="c-amber">169</span>], 99.90th=[<span class="c-amber">225</span>], 99.99th=[<span class="c-red">297</span>]
  <span class="c-cyan">cpu          :</span> usr=4.12%, sys=12.44%, ctx=241,419, majf=0, minf=14</code></pre>

        <div class="receipt-summary-bar">
          <div class="summary-item">
            <span class="summary-label font-mono">IOPS</span>
            <span class="summary-val font-mono text-accent">241,000 / sec</span>
          </div>
          <div class="summary-divider"></div>
          <div class="summary-item">
            <span class="summary-label font-mono">P50 LATENCY</span>
            <span class="summary-val font-mono text-accent">129.5 μs</span>
          </div>
          <div class="summary-divider"></div>
          <div class="summary-item">
            <span class="summary-label font-mono">PAGE CACHE</span>
            <span class="summary-val font-mono">0.00 kB (BYPASS)</span>
          </div>
        </div>
      </div>

      <!-- Panel 2: Kernel Perf -->
      <div class="receipt-panel panel-perf" role="tabpanel">
        <div class="receipt-cmd-row">
          <span class="prompt-symbol font-mono">$</span>
          <span class="prompt-cmd font-mono">perf stat -B -e cycles,instructions,cache-references,cache-misses,L1-dcache-load-misses -- ./zerocruft-bench</span>
        </div>

        <pre class="receipt-code-block font-mono"><code><span class="c-dim">Performance counter stats for './zerocruft-bench' (10 runs):</span>

  <span class="c-bright">4,128,491,204</span>      cycles                    <span class="c-cyan">#    4.821 GHz</span>
 <span class="c-accent">10,734,077,130</span>      instructions              <span class="c-accent">#    2.60  insn per cycle</span>
     <span class="c-bright">28,144,902</span>      cache-references          <span class="c-cyan">#   32.868 M/sec</span>
      <span class="c-accent">1,407,245</span>      cache-misses              <span class="c-accent">#    5.00% of all L1D hits</span>
      <span class="c-bright">4,219,812</span>      L1-dcache-load-misses     <span class="c-cyan">#    0.82% of L1-dcache</span>

  <span class="c-bright">0.856350711</span> seconds time elapsed (<span class="c-accent">± 0.12%</span>)
  <span class="c-bright">0.854120000</span> seconds user | <span class="c-accent">0.002230000</span> seconds sys</code></pre>

        <div class="receipt-summary-bar">
          <div class="summary-item">
            <span class="summary-label font-mono">IPC EFFICIENCY</span>
            <span class="summary-val font-mono text-accent">2.60 INS/CYCLE</span>
          </div>
          <div class="summary-divider"></div>
          <div class="summary-item">
            <span class="summary-label font-mono">L3 AFFINITY</span>
            <span class="summary-val font-mono text-accent">95.0% HIT RATE</span>
          </div>
          <div class="summary-divider"></div>
          <div class="summary-item">
            <span class="summary-label font-mono">KERNEL OVERHEAD</span>
            <span class="summary-val font-mono">0.26% SYS TIME</span>
          </div>
        </div>
      </div>

      <!-- Panel 3: Silicon Footprint -->
      <div class="receipt-panel panel-footprint" role="tabpanel">
        <div class="receipt-cmd-row">
          <span class="prompt-symbol font-mono">$</span>
          <span class="prompt-cmd font-mono">ps_mem --total | grep -E "zerocruft-daemon|slack|teams-for-linux"</span>
        </div>

        <pre class="receipt-code-block font-mono"><code><span class="c-dim"> Private   +   Shared   =  RAM Used	Program</span>
 ---------------------------------------------------------
 <span class="c-accent">748.0 KiB +  412.0 KiB =    1.1 MiB</span>	<span class="c-accent">zerocruft-daemon (Rust / Zen4)</span>
 412.8 MiB +   88.4 MiB =  501.2 MiB	teams-for-linux (Chromium)
 684.2 MiB +  112.5 MiB =  796.7 MiB	slack (Electron v31)
 ---------------------------------------------------------
 <span class="c-bright">TOTAL RUNTIME MEMORY DELTA:</span>
 <span class="c-accent">1.1 MiB</span> vs <span class="c-red">1,297.9 MiB</span> (<span class="c-accent">99.91% Silicon Waste Eradicated</span>)</code></pre>

        <div class="receipt-summary-bar">
          <div class="summary-item">
            <span class="summary-label font-mono">NATIVE DAEMON</span>
            <span class="summary-val font-mono text-accent">1.1 MiB RAM</span>
          </div>
          <div class="summary-divider"></div>
          <div class="summary-item">
            <span class="summary-label font-mono">WEB RUNTIME</span>
            <span class="summary-val font-mono text-red">1,297.9 MiB</span>
          </div>
          <div class="summary-divider"></div>
          <div class="summary-item">
            <span class="summary-label font-mono">MEMORY RATIO</span>
            <span class="summary-val font-mono text-accent">1,179x LEANER</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Terminal Footer Status Strip -->
    <div class="terminal-footer font-mono">
      <div class="footer-left">
        <span class="footer-check">✓</span>
        <span class="footer-hash">RECEIPT SHA256: 8f9b2c...e41a</span>
      </div>
      <div class="footer-right">
        <span>ARCH LINUX // 0 kB CLIENT JS</span>
      </div>
    </div>
  </div>
</div>

<style>
  .terminal-receipt-root {
    width: 100%;
    max-width: 580px;
    margin: 0 auto;
  }

  .terminal-card {
    background: var(--surface-code);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-lg);
    min-height: 488px;
    box-sizing: border-box;
    box-shadow: 
      0 24px 48px -12px rgba(0, 0, 0, 0.8),
      0 0 24px rgba(48, 209, 88, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }

  /* Terminal Header Frame */
  .terminal-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 48px;
    padding: 0 var(--space-4);
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .terminal-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .terminal-prompt-sym {
    color: var(--color-accent);
    font-weight: 700;
  }

  .terminal-user {
    color: var(--color-text-primary);
  }

  .terminal-host {
    color: var(--color-text-tertiary);
  }

  .terminal-status-tag {
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 600;
    padding: var(--space-1) var(--space-2);
    background: rgba(48, 209, 88, 0.08);
    border: 1px solid rgba(48, 209, 88, 0.22);
    border-radius: var(--radius-sm);
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }

  /* Sr-only class for accessible hidden radios */
  .sr-only {
    position: absolute;
    width: 0;
    height: 0;
    padding: 0;
    margin: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
    pointer-events: none;
    opacity: 0;
  }

  /* Interactive Tab Switcher */
  .receipt-tabs {
    display: flex;
    background: rgba(0, 0, 0, 0.4);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding: var(--space-1);
    gap: var(--space-1);
  }

  .receipt-tab-label {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    border-radius: var(--radius-sm);
    cursor: pointer;
    user-select: none;
    transition: var(--spring-micro);
  }

  .receipt-tab-label:hover {
    color: var(--color-text-primary);
    background: rgba(255, 255, 255, 0.04);
  }

  .tab-icon {
    opacity: 0.7;
    flex-shrink: 0;
  }

  .tab-badge {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-text-tertiary);
  }

  /* Radio Checked Styling via CSS :has() */
  .terminal-card:has(#tab-nvme:checked) .tab-label-nvme,
  .terminal-card:has(#tab-perf:checked) .tab-label-perf,
  .terminal-card:has(#tab-footprint:checked) .tab-label-footprint {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.09);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .terminal-card:has(#tab-nvme:checked) .tab-label-nvme .tab-badge,
  .terminal-card:has(#tab-perf:checked) .tab-label-perf .tab-badge,
  .terminal-card:has(#tab-footprint:checked) .tab-label-footprint .tab-badge {
    background: rgba(48, 209, 88, 0.2);
    color: var(--color-accent);
  }

  /* Fallback tab panel visibility */
  .receipt-panel {
    display: none;
    padding: var(--space-4);
  }

  /* Switch active panel based on radio :checked */
  .terminal-card:has(#tab-nvme:checked) .panel-nvme {
    display: block;
  }

  .terminal-card:has(#tab-perf:checked) .panel-perf {
    display: block;
  }

  .terminal-card:has(#tab-footprint:checked) .panel-footprint {
    display: block;
  }

  /* Command Row */
  .receipt-cmd-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .prompt-symbol {
    color: var(--color-accent);
    font-weight: 700;
    user-select: none;
  }

  .prompt-cmd {
    font-size: 0.75rem;
    color: #cbd5e1;
    word-break: break-all;
    line-height: 1.4;
  }

  /* Code Output Block */
  .receipt-code-block {
    margin: 0 0 var(--space-3) 0;
    padding: var(--space-3);
    background: rgba(0, 0, 0, 0.3);
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    line-height: 1.55;
    color: #e2e8f0;
    overflow-x: auto;
  }

  /* Syntax Highlighting Tokens */
  .c-dim { color: #64748b; }
  .c-accent { color: var(--color-accent); font-weight: 600; }
  .c-bright { color: #f8fafc; font-weight: 600; }
  .c-cyan { color: #38bdf8; }
  .c-amber { color: #fbbf24; }
  .c-red { color: #f87171; }
  .text-red { color: #f87171; }

  /* Summary Metrics Bar */
  .receipt-summary-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
  }

  .summary-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .summary-label {
    font-size: 0.625rem;
    color: var(--color-text-tertiary);
    letter-spacing: 0.05em;
  }

  .summary-val {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .text-accent {
    color: var(--color-accent);
  }

  .summary-divider {
    width: 1px;
    height: 24px;
    background: rgba(255, 255, 255, 0.08);
  }

  /* Footer Status Strip */
  .terminal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-4);
    background: rgba(0, 0, 0, 0.6);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.6875rem;
    color: var(--color-text-tertiary);
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .footer-check {
    color: var(--color-accent);
    font-weight: 700;
  }

  .footer-right {
    letter-spacing: 0.04em;
  }

  @media (max-width: 500px) {
    .receipt-tabs {
      flex-direction: column;
    }
    .summary-divider {
      display: none;
    }
    .receipt-summary-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
    .terminal-footer {
      flex-direction: column;
      gap: 4px;
      align-items: flex-start;
    }
  }
</style>
