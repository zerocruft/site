---
---

<section id="launch" class="launch-section">
  <div class="card-glass launch-card">
    <div class="launch-header">
      <div class="launch-status">
        <span class="pill pill-accent">
          <span class="pill-dot"></span>
          IN PRODUCTION
        </span>
        <span class="launch-phase font-mono text-footnote">BENCHMARKING SPRINT</span>
      </div>
      <span class="font-mono text-footnote hardware-badge">HW RIG: X230 / i5-3320M / 4GB RAM</span>
    </div>

    <div class="launch-content">
      <div class="launch-text">
        <h3 class="text-title-1 launch-title">Video #1 Launching Soon</h3>
        <p class="text-body launch-desc">
          We are currently benchmarking low-spec hardware under aggressive thermal and RAM constraints.
          Zero fake synthetic graphs. When Video #1 premieres, the exact reproducible kernel sysctl tweaks,
          JVM flags, and terminal receipts will drop right here as a companion guide.
        </p>

        <div class="launch-specs-grid">
          <div class="spec-card">
            <span class="spec-label">Target Environment</span>
            <span class="spec-value">Arch Linux (Zen Kernel)</span>
          </div>
          <div class="spec-card">
            <span class="spec-label">Constraint Envelope</span>
            <span class="spec-value">4 GB DDR3 • Intel HD 4000</span>
          </div>
          <div class="spec-card">
            <span class="spec-label">Verification Standard</span>
            <span class="spec-value">1% Lows, perf, zram-generator</span>
          </div>
        </div>
      </div>

      <div class="launch-cta-col">
        <a
          href="https://www.youtube.com/@zerocruft"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-youtube launch-btn"
          aria-label="Subscribe to ZeroCruft on YouTube"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          <span>Subscribe for Premiere</span>
        </a>
        <span class="text-footnote text-center launch-subtext">Direct to @zerocruft on YouTube</span>
      </div>
    </div>
  </div>
</section>

<style>
  .launch-section {
    margin-top: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .launch-card {
    padding: var(--space-6);
    border-color: rgba(48, 209, 88, 0.22);
    box-shadow: 0 12px 36px -10px rgba(0, 0, 0, 0.6), inset 0 1px 0 0 rgba(48, 209, 88, 0.15);
  }

  @media (min-width: 640px) {
    .launch-card {
      padding: var(--space-8);
    }
  }

  .launch-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: var(--border-subtle);
  }

  .launch-status {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .launch-phase {
    color: var(--color-text-tertiary);
    letter-spacing: 0.05em;
  }

  .hardware-badge {
    background: rgba(255, 255, 255, 0.04);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    border: var(--border-subtle);
    color: var(--color-text-secondary);
  }

  .launch-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 800px) {
    .launch-content {
      grid-template-columns: 1fr 240px;
      align-items: center;
    }
  }

  .launch-title {
    margin-bottom: var(--space-3);
    color: #ffffff;
  }

  .launch-desc {
    margin-bottom: var(--space-6);
    line-height: 1.65;
  }

  .launch-specs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 580px) {
    .launch-specs-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .spec-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: rgba(0, 0, 0, 0.3);
    border: var(--border-subtle);
  }

  .spec-label {
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-tertiary);
    margin-bottom: 4px;
  }

  .spec-value {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .launch-cta-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .launch-btn {
    width: 100%;
    min-height: 48px;
    font-size: 1rem;
  }

  .launch-subtext {
    color: var(--color-text-tertiary);
  }
</style>
