---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/schema/ArticleSchema.astro';
import VideoSchema from '../../components/schema/VideoSchema.astro';

export async function getStaticPaths() {
  try {
    const guides = await getCollection('guides', ({ data }) => !data.draft);
    return guides.map((guide) => ({
      params: { slug: guide.id },
      props: { guide },
    }));
  } catch {
    return [];
  }
}

const { guide } = Astro.props;
if (!guide) {
  return Astro.redirect('/');
}

const { Content } = await render(guide);
const canonicalUrl = `https://site.zerocruft.workers.dev/guides/${guide.id}`;
---

<BaseLayout
  title={`${guide.data.title} | ZeroCruft Companion Guide`}
  description={guide.data.description}
  canonicalUrl={canonicalUrl}
>
  <ArticleSchema
    title={guide.data.title}
    description={guide.data.description}
    canonicalUrl={canonicalUrl}
    pubDate={guide.data.pubDate}
    updatedDate={guide.data.updatedDate}
    keywords={guide.data.tags}
  />
  {guide.data.videoId && (
    <VideoSchema
      title={guide.data.videoTitle || guide.data.title}
      description={guide.data.description}
      videoId={guide.data.videoId}
      uploadDate={guide.data.videoUploadDate || guide.data.pubDate}
      duration={guide.data.duration}
    />
  )}

  <article class="guide-article container">
    <header class="guide-header">
      <a href="/#guides" class="back-link font-mono text-footnote">← Return to Companion Hub</a>
      <h1 class="guide-title">{guide.data.title}</h1>
      <div class="guide-meta">
        <span class="font-mono text-footnote">
          Published: {guide.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
        </span>
        {guide.data.tags && guide.data.tags.length > 0 && (
          <div class="tags-row">
            {guide.data.tags.map((tag: string) => (
              <span class="pill font-mono">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    {guide.data.videoId && (
      <div class="video-embed-card">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${guide.data.videoId}`}
          title={guide.data.videoTitle || guide.data.title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          class="video-iframe"
        />
      </div>
    )}

    <div class="guide-prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .guide-article {
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
    max-width: 820px;
  }

  .guide-header {
    margin-bottom: var(--space-8);
  }

  .back-link {
    color: var(--color-accent);
    display: inline-block;
    margin-bottom: var(--space-4);
  }

  .guide-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--space-3);
  }

  .guide-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-tertiary);
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .video-embed-card {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    margin-bottom: var(--space-8);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: var(--border-subtle);
    background: #000;
    box-shadow: var(--shadow-elevated);
  }

  .video-iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .guide-prose {
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .guide-prose :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: var(--border-subtle);
  }

  .guide-prose :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }

  .guide-prose :global(p) {
    margin-bottom: var(--space-4);
  }

  .guide-prose :global(pre) {
    background: var(--color-surface-code);
    border: var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    overflow-x: auto;
    margin-bottom: var(--space-6);
  }

  .guide-prose :global(code:not(pre code)) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: rgba(255, 255, 255, 0.08);
    padding: 2px 6px;
    border-radius: 4px;
    color: #e6edf3;
  }
</style>
