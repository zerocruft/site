---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalReceipt from '../components/TerminalReceipt.astro';
import RigSpecs from '../components/RigSpecs.astro';
import { getCollection } from 'astro:content';

let guides: any[] = [];
try {
  guides = await getCollection('guides', ({ data }) => !data.draft);
} catch {
  guides = [];
}
---

<BaseLayout>
  <!-- Split Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-split-grid">
        <!-- Left Column: Typography & CTAs -->
        <div class="hero-content">
          <div class="hero-badge-strip">
            <a
              href="https://www.youtube.com/@zerocruft"
              target="_blank"
              rel="noopener noreferrer"
              class="pill pill-youtube-link"
            >
              <span class="pill-dot youtube-dot"></span>
              YouTube @zerocruft
            </a>
            <span class="pill font-mono">Arch Linux // Zen 4</span>
            <span class="pill font-mono pill-zero-js">0 kB JS</span>
          </div>

          <h1 class="hero-title">
            Anti-Bloat Engineering.<br />
            <span class="text-accent-solid">Terminal Receipts.</span><br />
            Raw Silicon.
          </h1>

          <p class="hero-subtitle">
            Low-level Linux systems engineering and hardware constraint benchmarks. We inspect NVMe Direct-I/O throughput, tune kernel memory parameters, and establish reproducible benchmark receipts without unnecessary abstraction layers.
          </p>

          <div class="hero-actions">
            <a
              href="https://www.youtube.com/@zerocruft"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-youtube"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              <span>Subscribe on YouTube</span>
            </a>

            <a href="#manifesto" class="btn btn-secondary">
              <span>Read Manifesto</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <polyline points="19 12 12 19 5 12"></polyline>
              </svg>
            </a>

            <a href="/llms.txt" class="btn btn-ghost font-mono text-footnote" title="Plain Markdown Manifest for LLMs">
              <span>llms.txt</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>

          <!-- Micro Hardware Telemetry Receipt -->
          <div class="hero-telemetry-row font-mono">
            <span class="telemetry-item"><span class="telemetry-dot"></span> DIRECT-I/O BYPASS</span>
            <span class="telemetry-sep">•</span>
            <span class="telemetry-item">SUB-60NS MEMORY</span>
            <span class="telemetry-sep">•</span>
            <span class="telemetry-item">0 kB CLIENT RUNTIME</span>
          </div>
        </div>

        <!-- Right Column: Interactive Pure CSS Terminal Receipt -->
        <div class="hero-terminal-col">
          <TerminalReceipt />
        </div>
      </div>
    </div>
  </section>

  <!-- Hardware Benchmark Rig Telemetry Strip -->
  <RigSpecs />

  <!-- The Anti-Bloat Manifesto -->
  <section id="manifesto" class="manifesto-section">
    <div class="container">
      <div class="section-header">
        <span class="pill pill-accent">THE CORE DIRECTIVES</span>
        <h2 class="text-title-1 section-title">The Anti-Bloat Manifesto</h2>
        <p class="text-body section-desc">
          Modern computing has substituted memory bandwidth for discipline. ZeroCruft stands for four uncompromising engineering truths.
        </p>
      </div>

      <div class="manifesto-grid">
        <div class="card-glass-elevated manifesto-card">
          <div class="manifesto-badge font-mono">[DIRECTIVE 0x01]</div>
          <h3 class="text-headline manifesto-card-title">Constraint is the True Benchmark</h3>
          <p class="text-body manifesto-card-desc">
            Any software can seem smooth when fed 64GB of DDR5 and a 24-core CPU. Real engineering begins when resources are finite. If a tool cannot run gracefully on a 10-year-old dual-core, it is not progressive—it is negligent.
          </p>
        </div>

        <div class="card-glass-elevated manifesto-card">
          <div class="manifesto-badge font-mono">[DIRECTIVE 0x02]</div>
          <h3 class="text-headline manifesto-card-title">Terminal Receipts Over Sentiments</h3>
          <p class="text-body manifesto-card-desc">
            No synthetic manufacturer slides. No promotional cherry-picking. Every optimization claim on ZeroCruft is backed by verifiable <code class="inline-code">perf stat</code>, frame-time percentile tails, and raw shell logs.
          </p>
        </div>

        <div class="card-glass-elevated manifesto-card">
          <div class="manifesto-badge font-mono">[DIRECTIVE 0x03]</div>
          <h3 class="text-headline manifesto-card-title">Eradicate Software Cruelty</h3>
          <p class="text-body manifesto-card-desc">
            Bloatware, background telemetry, Electron wrappers, and unnecessary daemon layers degrade silicon lifespan and rob users of agency. We strip systems down to clean kernel primitives and honest binaries.
          </p>
        </div>

        <div class="card-glass-elevated manifesto-card">
          <div class="manifesto-badge font-mono">[DIRECTIVE 0x04]</div>
          <h3 class="text-headline manifesto-card-title">The Zero Client JS Ideal</h3>
          <p class="text-body manifesto-card-desc">
            Deliver maximum utility with the absolute minimum computational overhead. This platform ships 0 kB client-side framework JavaScript, loads instantly on low-bandwidth cellular, and respects user battery cycles.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Video Companion Guides Archive -->
  <section id="guides" class="guides-section">
    <div class="container">
      <div class="section-header">
        <span class="pill pill-accent">COMPANION HUB</span>
        <h2 class="text-title-1 section-title">Video Companion Guides</h2>
        <p class="text-body section-desc">
          When videos premiere on YouTube, full reproducible companion guides, terminal logs, and kernel tuning flags populate here.
        </p>
      </div>

      {guides.length > 0 ? (
        <div class="guides-grid">
          {guides.map((guide) => (
            <a href={`/guides/${guide.id}`} class="card-glass-elevated guide-card">
              <span class="font-mono text-footnote guide-date">
                {guide.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </span>
              <h3 class="text-title-2 guide-title">{guide.data.title}</h3>
              <p class="text-body guide-desc">{guide.data.description}</p>
              <div class="guide-footer">
                <span class="guide-link-cta font-mono text-footnote">View Terminal Receipts →</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="card-glass-elevated empty-guides-card">
          <div class="pipeline-monitor-header">
            <span class="radar-ping" aria-hidden="true"></span>
            <span class="pipeline-tag font-mono">HARDWARE PIPELINE ACTIVE // REPRODUCING BENCHMARKS</span>
          </div>
          
          <div class="empty-icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="empty-icon">
              <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
              <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
              <line x1="6" y1="6" x2="6.01" y2="6"></line>
              <line x1="6" y1="18" x2="6.01" y2="18"></line>
            </svg>
          </div>

          <h3 class="text-title-2 empty-title">Companion Pipeline Ready</h3>
          <p class="text-body empty-desc">
            Video #1 is undergoing rigorous hardware constraint benchmarks on our AMD Zen 4 test rig. The moment the video premieres on <a href="https://www.youtube.com/@zerocruft" target="_blank" rel="noopener noreferrer" class="link-inline">@zerocruft</a>, its full companion guide, complete with exact copy-paste configuration flags and terminal receipts, will deploy here.
          </p>

          <div class="empty-actions">
            <a href="https://www.youtube.com/@zerocruft" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              Follow on YouTube
            </a>
            <a href="/rss.xml" class="btn btn-ghost font-mono text-footnote">
              Subscribe to RSS Feed
            </a>
            <a href="/llms.txt" class="btn btn-ghost font-mono text-footnote">
              View llms.txt
            </a>
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  /* Split Hero */
  .hero-section {
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }

  @media (min-width: 768px) {
    .hero-section {
      padding-top: var(--space-12);
      padding-bottom: var(--space-12);
    }
  }

  .hero-container {
    max-width: 1200px;
  }

  .hero-split-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero-split-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .hero-badge-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .pill-youtube-link {
    background: var(--color-youtube-subtle);
    border-color: rgba(255, 51, 51, 0.25);
    color: #ff6666;
    transition: var(--spring-micro);
  }

  .pill-youtube-link:hover {
    background: rgba(255, 51, 51, 0.20);
    color: #ff8080;
  }

  .youtube-dot {
    background: #ff3333;
    box-shadow: 0 0 6px #ff3333;
  }

  .pill-zero-js {
    background: rgba(48, 209, 88, 0.12);
    border-color: rgba(48, 209, 88, 0.28);
    color: var(--color-accent);
  }

  .hero-title {
    margin-bottom: var(--space-4);
    letter-spacing: -0.035em;
    font-size: 2.25rem;
    line-height: 1.12;
  }

  @media (min-width: 640px) {
    .hero-title {
      font-size: 2.75rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-title {
      font-size: 3.25rem;
    }
  }

  .text-accent-solid {
    color: var(--color-accent);
  }

  .hero-subtitle {
    max-width: 540px;
    margin-bottom: var(--space-6);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .hero-telemetry-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.6875rem;
    color: var(--color-text-tertiary);
    letter-spacing: 0.04em;
    padding-top: var(--space-3);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    width: 100%;
  }

  .telemetry-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .telemetry-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .telemetry-sep {
    color: rgba(255, 255, 255, 0.15);
  }

  .hero-terminal-col {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  /* Section Headers */
  .section-header {
    text-align: center;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: var(--space-8);
  }

  .section-title {
    margin-top: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .section-desc {
    color: var(--color-text-secondary);
  }

  /* Manifesto Section */
  .manifesto-section {
    padding-top: var(--space-10);
    padding-bottom: var(--space-12);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .manifesto-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .manifesto-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }
  }

  .manifesto-card {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
  }

  .manifesto-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: var(--space-3);
    letter-spacing: 0.05em;
  }

  .manifesto-card-title {
    margin-bottom: var(--space-2);
    color: var(--color-text-primary);
  }

  .manifesto-card-desc {
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .inline-code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: rgba(255, 255, 255, 0.08);
    padding: var(--space-1) var(--space-2);
    border-radius: 4px;
    color: #e6edf3;
  }

  /* Guides Section */
  .guides-section {
    padding-top: var(--space-10);
    padding-bottom: var(--space-16);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .empty-guides-card {
    padding: var(--space-6);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 680px;
    margin: 0 auto;
  }

  .pipeline-monitor-header {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px;
    background: rgba(48, 209, 88, 0.08);
    border: 1px solid rgba(48, 209, 88, 0.22);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-5);
  }

  .radar-ping {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 8px var(--color-accent);
  }

  .pipeline-tag {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }

  .empty-icon-wrap {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
    color: var(--color-accent);
  }

  .empty-title {
    margin-bottom: var(--space-2);
  }

  .empty-desc {
    margin-bottom: var(--space-6);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }

  .link-inline {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .guides-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .guides-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .guide-card {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
  }

  .guide-date {
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-2);
  }

  .guide-title {
    margin-bottom: var(--space-2);
  }

  .guide-desc {
    margin-bottom: var(--space-4);
  }

  .guide-footer {
    margin-top: auto;
  }

  .guide-link-cta {
    color: var(--color-accent);
  }
</style>
