---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

let guides: any[] = [];
try {
  guides = await getCollection('guides', ({ data }) => !data.draft);
} catch {
  guides = [];
}
---

<BaseLayout>
  <!-- Hero Section: Pure High-Contrast Editorial Systems Statement (Zero Terminal Clutter) -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-eyebrow font-mono">
        <span class="eyebrow-badge text-accent">LINUX SYSTEMS</span>
        <span class="eyebrow-sep">//</span>
        <span class="eyebrow-badge">DEBLOAT GUIDES</span>
        <span class="eyebrow-sep">//</span>
        <span class="eyebrow-stat">0 kB JAVASCRIPT</span>
      </div>

      <h1 class="hero-title">
        Practical Linux debloating.<br />
        Clean dotfiles.<br />
        Zero synthetic hype.
      </h1>

      <p class="hero-lead">
        Step-by-step guides, shell scripts, and system configurations to strip unnecessary background services and keep Linux machines fast and responsive. Every guide comes with verifiable commands you can inspect and run yourself.
      </p>

      <div class="hero-actions">
        <a
          href="https://www.youtube.com/@zerocruft"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-youtube"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          <span>Subscribe on YouTube</span>
        </a>

        <a href="#manifesto" class="btn btn-secondary">
          <span>Read Manifesto</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
        </a>

        <a href="/llms.txt" class="btn btn-ghost font-mono text-footnote" title="Plain Markdown Manifest for LLMs">
          <span>llms.txt</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>

      <!-- Integrated 4-Pillar Baseline (1px Hairline Dividers) -->
      <div class="hero-telemetry-matrix font-mono">
        <div class="telemetry-cell">
          <span class="telemetry-metric text-accent">0 kB</span>
          <span class="telemetry-label">Client JS Runtime</span>
        </div>
        <div class="telemetry-cell">
          <span class="telemetry-metric">100%</span>
          <span class="telemetry-label">Verifiable Shell Receipts</span>
        </div>
        <div class="telemetry-cell">
          <span class="telemetry-metric">0</span>
          <span class="telemetry-label">Paid Sponsor Placements</span>
        </div>
        <div class="telemetry-cell">
          <span class="telemetry-metric">OPEN</span>
          <span class="telemetry-label">Plain Text & RSS Feeds</span>
        </div>
      </div>
    </div>
  </section>

  <!-- The Anti-Bloat Principles (Editorial Format) -->
  <section id="manifesto" class="manifesto-section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow font-mono text-accent">THE ZERO CRUFT PRINCIPLES</span>
        <h2 class="section-title">How We Build and Test</h2>
        <p class="section-desc">
          We focus on lightweight systems, battery life, and clean terminal workflows. Here is the standard every video and guide follows.
        </p>
      </div>

      <!-- Typographic Editorial Table (Zero Card Soup) -->
      <div class="manifesto-table">
        <article class="manifesto-row">
          <div class="row-num font-mono">01</div>
          <h3 class="row-title">Low-Spec First</h3>
          <p class="row-statement">
            Any software can seem fast when fed top-tier hardware and excessive RAM. Real optimization begins under constraints. We build and test configs to ensure they stay responsive on modest laptops and everyday machines.
          </p>
        </article>

        <article class="manifesto-row">
          <div class="row-num font-mono">02</div>
          <h3 class="row-title">Verifiable Shell Commands</h3>
          <p class="row-statement">
            No promotional slides or unsubstantiated claims. Every guide provides the exact terminal commands, configuration diffs, and package lists so you know exactly what is changing on your system.
          </p>
        </article>

        <article class="manifesto-row">
          <div class="row-num font-mono">03</div>
          <h3 class="row-title">Strip Unnecessary Services</h3>
          <p class="row-statement">
            Background telemetry daemons, unvetted autostart helpers, and unnecessary wrapper processes quietly consume memory and battery cycles. We audit and trim systems down to clean, transparent defaults.
          </p>
        </article>

        <article class="manifesto-row">
          <div class="row-num font-mono">04</div>
          <h3 class="row-title">Zero Client JavaScript</h3>
          <p class="row-statement">
            This companion site is built with pure semantic HTML and CSS, shipping 0 kB of client JavaScript. It loads instantly on mobile, respects your data allowance, and consumes zero idle CPU.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Video Companion Guides Archive -->
  <section id="guides" class="guides-section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow font-mono text-accent">REPRODUCIBLE ARTIFACTS</span>
        <h2 class="section-title">Video Companion Guides</h2>
        <p class="section-desc">
          When videos premiere on YouTube, full reproducible companion guides, terminal logs, and kernel tuning flags populate here.
        </p>
      </div>

      {guides.length > 0 ? (
        <div class="guides-table">
          {guides.map((guide) => (
            <a href={`/guides/${guide.id}`} class="guide-row">
              <span class="guide-date font-mono">
                {guide.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </span>
              <div class="guide-body">
                <h3 class="guide-title">{guide.data.title}</h3>
                <p class="guide-desc">{guide.data.description}</p>
              </div>
              <span class="guide-cta font-mono">View Receipts →</span>
            </a>
          ))}
        </div>
      ) : (
        <!-- Systems Dispatch Block (Zero Toy Empty State) -->
        <div class="pipeline-dispatch-container font-mono">
          <div class="dispatch-header">
            <div class="dispatch-header-left">
              <span class="dispatch-pill">[COMPANION PIPELINE]</span>
            </div>
            <div class="dispatch-header-right">
              <span>UPCOMING EPISODES</span>
            </div>
          </div>

          <div class="dispatch-body">
            <div class="dispatch-line">
              <span class="text-accent">> TOPICS:</span> Arch Linux & Debian minimal setups, window managers, memory reduction, and clean dotfiles.
            </div>
            <div class="dispatch-line">
              <span class="text-accent">> COMPANIONS:</span> Step-by-step terminal instructions, configuration files, and script links deploy alongside every video.
            </div>
            <div class="dispatch-line dispatch-desc">
              All guides and shell recipes are published directly here as companion resources to <a href="https://www.youtube.com/@zerocruft" target="_blank" rel="noopener noreferrer" class="link-inline">YouTube @zerocruft</a>.
            </div>
          </div>

          <div class="dispatch-actions">
            <a href="https://www.youtube.com/@zerocruft" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              Follow on YouTube
            </a>
            <a href="/rss.xml" class="btn btn-ghost font-mono text-footnote">
              Subscribe to RSS Feed
            </a>
            <a href="/llms.txt" class="btn btn-ghost font-mono text-footnote">
              View llms.txt
            </a>
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section: Editorial Systems Showcase */
  .hero-section {
    padding-top: var(--space-14);
    padding-bottom: var(--space-12);
  }

  .hero-container {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .eyebrow-badge {
    font-weight: 600;
  }

  .eyebrow-sep {
    color: rgba(255, 255, 255, 0.20);
  }

  .eyebrow-stat {
    color: var(--color-text-tertiary);
  }

  .hero-title {
    margin-bottom: var(--space-5);
    letter-spacing: -0.04em;
    font-size: 2.75rem;
    line-height: 1.05;
    font-weight: 800;
    color: #ffffff;
  }

  @media (min-width: 640px) {
    .hero-title {
      font-size: 3.75rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-title {
      font-size: 4.5rem;
    }
  }

  .hero-lead {
    max-width: 640px;
    margin-bottom: var(--space-8);
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-10);
  }

  /* 4-Pillar Baseline Telemetry Matrix */
  .hero-telemetry-matrix {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid rgba(255, 255, 255, 0.10);
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
    background: rgba(255, 255, 255, 0.01);
  }

  @media (min-width: 768px) {
    .hero-telemetry-matrix {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .telemetry-cell {
    padding: var(--space-5) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }

  .telemetry-cell:last-child {
    border-right: none;
  }

  .telemetry-metric {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .telemetry-label {
    font-size: 0.6875rem;
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Section Headers */
  .section-header {
    text-align: left;
    max-width: 720px;
    margin-bottom: var(--space-8);
  }

  .section-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    display: block;
    margin-bottom: var(--space-2);
  }

  .section-title {
    margin-bottom: var(--space-2);
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .section-desc {
    color: var(--color-text-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  /* Manifesto Editorial Table (Blueprint: manifesto-editorial) */
  .manifesto-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .manifesto-table {
    border-top: 1px solid rgba(255, 255, 255, 0.10);
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
  }

  .manifesto-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    padding: var(--space-6) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .manifesto-row:last-child {
    border-bottom: none;
  }

  @media (min-width: 768px) {
    .manifesto-row {
      grid-template-columns: 72px 280px 1fr;
      gap: var(--space-6);
      align-items: baseline;
      padding: var(--space-8) 0;
    }
  }

  .row-num {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .row-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .row-statement {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .inline-code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: rgba(255, 255, 255, 0.06);
    padding: 4px 8px;
    border-radius: 4px;
    color: #e6edf3;
  }

  /* Guides Section */
  .guides-section {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .guides-table {
    border-top: 1px solid rgba(255, 255, 255, 0.10);
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
  }

  .guide-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    transition: var(--spring-micro);
  }

  .guide-row:last-child {
    border-bottom: none;
  }

  @media (min-width: 768px) {
    .guide-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-6);
    }
  }

  .guide-row:hover {
    padding-left: var(--space-2);
  }

  .guide-date {
    font-size: 0.75rem;
    color: var(--color-text-tertiary);
    flex-shrink: 0;
    min-width: 100px;
  }

  .guide-body {
    flex-grow: 1;
  }

  .guide-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--space-1);
  }

  .guide-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .guide-cta {
    font-size: 0.8125rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* Pipeline Dispatch Block (Zero Card Soup) */
  .pipeline-dispatch-container {
    width: 100%;
    background: #08090c;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .dispatch-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-5);
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.75rem;
  }

  .dispatch-pill {
    color: var(--color-accent);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .dispatch-header-right {
    color: var(--color-text-tertiary);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
  }

  .dispatch-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #e6edf3;
  }

  .dispatch-line {
    word-break: break-word;
  }

  .dispatch-desc {
    color: var(--color-text-secondary);
    padding-top: var(--space-2);
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  .dispatch-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    background: rgba(0, 0, 0, 0.20);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .link-inline {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .text-accent {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .dispatch-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
    }
  }
</style>